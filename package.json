{
  "name": "twitchsim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "make:controls-ffx": "node scripts/make-controls-ffx.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:pages": "GITHUB_PAGES=1 vite build",
    "deploy": "npm run build:pages && gh-pages -d dist -m \"Deploy to GitHub Pages\"",
    "build:cep": "vite build --mode cep",
    "cep:install": "npm run build:cep && node scripts/install-cep.mjs",
    "cep:link": "npm run build:cep && node scripts/install-cep.mjs --link",
    "package": "npm run build:cep && node scripts/package-panel.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/inter": "^5.3.0",
    "fflate": "^0.8.3",
    "mediabunny": "^1.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Realistic Twitch chat simulator and transparent video exporter (alpha WebM / ProRes 4444 / PNG sequence, up to 4K).",
  "repository": {
    "type": "git",
    "url": "https://github.com/newomp4/twitchsim.git"
  },
  "license": "MIT",
  "homepage": "https://newomp4.github.io/twitchsim/",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
